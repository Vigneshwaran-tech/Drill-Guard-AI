# DrillGuard AI - Environment Configuration
# Nebius x NVIDIA Global AI Hackathon 2026 - Physical AI Track

# Nebius Token Factory / Studio API Key
# Sign up at https://studio.nebius.ai to obtain your API key
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius Token Factory API Base URL (OpenAI-compatible endpoint)
# Official endpoint: https://api.tokenfactory.nebius.com/v1/
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron Model on Nebius Token Factory
# Supported options:
# - nvidia/Llama-3_1-Nemotron-70B-Instruct-HF
# - nvidia/nemotron-4-340b-instruct
NEBIUS_MODEL=nvidia/Llama-3_1-Nemotron-70B-Instruct-HF
